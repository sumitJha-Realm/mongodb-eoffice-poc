# Copy to .env and fill in. Loaded by tools/* and the dashboard (via `source` or dotenv).
# k8s replica set (after ./scripts/port-forward.sh) — on the EC2 itself use the cluster-internal URI.
MONGO_URL=mongodb://admin:eoffice123@localhost:27101,localhost:27102,localhost:27103/?replicaSet=eoffice-rs&authSource=admin
# Voyage AI (created via Atlas UI -> AI Models -> Model API Keys)
VOYAGE_API_KEY=<your-voyage-key>
VOYAGE_MODEL=voyage-4-large
# LLM gateway (OpenAI Responses-compatible)
AI_GATEWAY_URL=https://ai-gateway.corp.mongodb.com/openai/v1/responses
AI_GATEWAY_API_KEY=<your-gateway-key>
AI_GATEWAY_MODEL=gpt-5.5
# Dashboard port (3000 = docker-compose fallback, 3001 = k8s mode on EC2)
PORT=3001
